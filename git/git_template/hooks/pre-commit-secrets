#!/bin/bash
# Pre-commit: block secrets and PII in staged changes.
#  1. gitleaks on the staged diff (skipped with a warning if not installed)
#  2. built-in PII patterns on added lines (SSN, credit card numbers)
#  3. optional per-machine denylist, one extended regex per line, never
#     tracked: ~/.config/git/pii-denylist (home address, phone, personal
#     email, etc.)
# Bypass a false positive once with: git commit --no-verify

status=0

if command -v gitleaks >/dev/null 2>&1; then
  gitleaks protect --staged --redact --no-banner -v || status=1
else
  echo "warning: gitleaks not installed, skipping secret scan (brew install gitleaks)" >&2
fi

added=$(git diff --cached -U0 --no-color --diff-filter=AM | grep -E '^\+[^+]|^\+$')

scan() { # label regex
  hits=$(printf '%s\n' "$added" | grep -E -n -- "$2")
  [ -n "$hits" ] && { echo "PII check failed ($1):" >&2; printf '%s\n' "$hits" | cut -c1-120 >&2; status=1; }
}

scan "SSN"         '(^|[^0-9])[0-9]{3}-[0-9]{2}-[0-9]{4}([^0-9]|$)'
scan "card number" '(^|[^0-9])(4[0-9]{3}|5[1-5][0-9]{2}|3[47][0-9]{2}|6011)([ -]?[0-9]{4}){2,3}([^0-9]|$)'

denylist=${XDG_CONFIG_HOME:-$HOME/.config}/git/pii-denylist
if [ -s "$denylist" ]; then
  while IFS= read -r pattern; do
    case "$pattern" in ''|'#'*) continue ;; esac
    scan "denylist: $pattern" "$pattern"
  done < "$denylist"
fi

[ $status -ne 0 ] && echo "COMMIT REJECTED (use --no-verify to override a false positive)" >&2
exit $status
