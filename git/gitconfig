[filter "media"]
	clean = git-media-clean %f
	smudge = git-media-smudge %f
[user]
	name = Eric Thompson
	email = 7454093+er0ck@users.noreply.github.com

# repos whose remote uses the ActiveState SSH host alias (see
# ~/.ssh/config) pick up the work identity instead. Path is untracked,
# machine-local, created per-machine (not part of this repo).
[includeIf "hasconfig:remote.*.url:git@github.com-activestate:*/**"]
	path = ~/.gitconfig-activestate
[color]
  # color opts: normal, black, red, green, yellow, blue, magenta, cyan, or white
  ui = auto
  interactive = auto
[core]
	excludesfile = ~/local_documents/projects/dotfiles/git/gitignore_global
	whitespace = trailing-space,space-before-tab
	autocrlf = input
[init]
	templatedir = ~/local_documents/projects/dotfiles/git/git_template
[alias]
  br = branch
  ci = commit -v
  cl = clone
  co = checkout
  cp = cherry-pick
  pl = pull -—rebase
  st = status -s
  lg = log --graph --pretty=format:'%Cred%h%Creset -%C(yellow)%d%Creset %s %Cgreen(%cr) %C(bold blue)<%an>%Creset' --abbrev-commit --date=relative
  ls = log --pretty=format:"%C(yellow)%h%Cred%d\\ %Creset%s%Cblue\\ [%cn]" --decorate --date=short
  ll = log --pretty=format:"%C(yellow)%h%Cred%d\\ %Creset%s%Cblue\\ [%cn]" --decorate --date=short --numstat
  # TODO: add preview/confirmation to the four below
  # FYI: to test these standalone, remove one of the escapes before { and } and \
  cleanbranches = !git branch --merged | grep  '.\\{15,\\}' | xargs -n 1 git branch -d
  cleanremote   = !git branch --remotes --merged | grep '^  origin.\\{35,\\}' | sed 's/^  origin\\///' | xargs -n 1 git push origin --delete
  resetstable   = !git fetch upstream && git reset --hard upstream/stable && git clean -f -d
  resetmaster   = !git fetch upstream && git reset --hard upstream/master && git clean -f -d
	pick = add --patch
	ctags = !.git/hooks/ctags
  fixup = commit --amend --no-edit
  whathaveidone = diff HEAD@{1}..HEAD
[merge]
	tool = gvimdiff
[push]
	default = current
